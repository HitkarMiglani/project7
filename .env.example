# Anthropic API Key (required if using Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key (optional / alternative provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Brave Search API Key (optional: for company context enrichment)
BRAVE_API_KEY=your_brave_search_api_key_here

# Logging (optional)
# KNAP_LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (default: INFO)
KNAP_LOG_LEVEL=INFO
# KNAP_LOG_FILE: path to also write logs to a file (default: console only)
# KNAP_LOG_FILE=logs/knapresume.log
